     1|     1|/* ===================================
     2|     2|   Design Tokens
     3|     3|   =================================== */
     4|     4|:root {
     5|     5|    --color-bg: #0a0a0a;
     6|     6|    --color-bg-secondary: #111;
     7|     7|    --color-bg-card: #141414;
     8|     8|    --color-bg-card-active: #1a1a1a;
     9|     9|    --color-text-primary: #e8e8e8;
    10|    10|    --color-text-secondary: #888;
    11|    11|    --color-text-muted: #666;
    12|    12|    --color-accent: #c49a3a;
    13|    13|    --color-accent-hover: #d4a843;
    14|    14|    --color-pop-green: #2d6a4f;
    15|    15|    --color-yellow: #c49a3a;
    16|    16|    --color-danger: #c41e3a;
    17|    17|    --color-danger-dark: #8b0000;
    18|    18|    --color-border: rgba(196, 154, 58, 0.15);
    19|    19|    --color-border-active: rgba(196, 154, 58, 0.4);
    20|    20|
    21|    21|    --font-heading: 'IM Fell English', 'Georgia', serif;
    22|    22|    --font-body: 'IBM Plex Sans', 'Segoe UI', sans-serif;
    23|    23|
    24|    24|    --radius-md: 8px;
    25|    25|    --radius-lg: 12px;
    26|    26|    --radius-xl: 16px;
    27|    27|
    28|    28|    --transition-fast: 150ms ease;
    29|    29|    --transition-base: 300ms ease;
    30|    30|    --transition-slow: 500ms ease;
    31|    31|
    32|    32|    --counter-height: 160px;
    33|    33|}
    34|    34|
    35|    35|/* ===================================
    36|    36|   Reset & Base
    37|    37|   =================================== */
    38|    38|*, *::before, *::after {
    39|    39|    margin: 0;
    40|    40|    padding: 0;
    41|    41|    box-sizing: border-box;
    42|    42|}
    43|    43|
    44|    44|html {
    45|    45|    font-size: 16px;
    46|    46|    scroll-behavior: auto;
    47|    47|}
    48|    48|
    49|    49|body {
    50|    50|    background: var(--color-bg);
    51|    51|    color: var(--color-text-primary);
    52|    52|    font-family: var(--font-body);
    53|    53|    line-height: 1.6;
    54|    54|    overflow-x: hidden;
    55|    55|    -webkit-text-size-adjust: 100%;
    56|    56|}
    57|    57|
    58|    58|/* ===================================
    59|    59|   Splash Overlay
    60|    60|   =================================== */
    61|    61|.splash {
    62|    62|    position: fixed;
    63|    63|    inset: 0;
    64|    64|    z-index: 9999;
    65|    65|    background: var(--color-bg);
    66|    66|    display: flex;
    67|    67|    align-items: center;
    68|    68|    justify-content: center;
    69|    69|    padding: 2rem 1rem;
    70|    70|    opacity: 1;
    71|    71|    transition: opacity 0.5s ease;
    72|    72|}
    73|    73|
    74|    74|.splash.hidden {
    75|    75|    opacity: 0;
    76|    76|    pointer-events: none;
    77|    77|}
    78|    78|
    79|    79|.splash-inner {
    80|    80|    max-width: 600px;
    81|    81|    text-align: center;
    82|    82|}
    83|    83|
    84|    84|.splash-title {
    85|    85|    font-family: var(--font-heading);
    86|    86|    font-size: clamp(2rem, 6vw, 3rem);
    87|    87|    font-weight: 400;
    88|    88|    letter-spacing: 0.05em;
    89|    89|    color: var(--color-text-primary);
    90|    90|    margin-bottom: 0.5rem;
    91|    91|}
    92|    92|
    93|    93|.splash-subtitle {
    94|    94|    font-family: var(--font-body);
    95|    95|    font-size: clamp(1rem, 2.5vw, 1.2rem);
    96|    96|    color: var(--color-text-secondary);
    97|    97|    font-style: italic;
    98|    98|    margin-bottom: 2rem;
    99|    99|}
   100|   100|
   101|   101|.splash-image {
   102|   102|    margin: 0 auto 2rem;
   103|   103|    max-width: 500px;
   104|   104|}
   105|   105|
   106|   106|.splash-image img {
   107|   107|    width: 100%;
   108|   108|    height: auto;
   109|   109|    border-radius: var(--radius-lg);
   110|   110|    display: block;
   111|   111|}
   112|   112|
   113|   113|.splash-image figcaption {
   114|   114|    font-size: 0.8rem;
   115|   115|    color: var(--color-text-muted);
   116|   116|    margin-top: 0.5rem;
   117|   117|    font-style: italic;
   118|   118|}
   119|   119|
   120|   120|.splash-text {
   121|   121|    text-align: left;
   122|   122|    margin-bottom: 2rem;
   123|   123|    font-family: var(--font-body);
   124|   124|}
   125|   125|
   126|   126|.splash-text p {
   127|   127|    margin-bottom: 1rem;
   128|   128|    font-size: 1.05rem;
   129|   129|    color: var(--color-text-secondary);
   130|   130|}
   131|   131|
   132|   132|.splash-text strong {
   133|   133|    color: var(--color-text-primary);
   134|   134|}
   135|   135|
   136|   136|.splash-enter {
   137|   137|    font-family: var(--font-body);
   138|   138|    font-size: 1rem;
   139|   139|    padding: 14px 2rem;
   140|   140|    background: transparent;
   141|   141|    border: 2px solid var(--color-accent);
   142|   142|    color: var(--color-accent);
   143|   143|    cursor: pointer;
   144|   144|    text-transform: uppercase;
   145|   145|    letter-spacing: 0.15em;
   146|   146|    border-radius: var(--radius-md);
   147|   147|    transition: all var(--transition-base);
   148|   148|    font-weight: 600;
   149|   149|}
   150|   150|
   151|   151|.splash-enter:hover {
   152|   152|    background: var(--color-accent);
   153|   153|    color: var(--color-bg);
   154|   154|}
   155|   155|
   156|   156|/* ===================================
   157|   157|   Sticky Counter
   158|   158|   =================================== */
   159|   159|.counter-sticky {
   160|   160|    position: sticky;
   161|   161|    top: 0;
   162|   162|    z-index: 50;
   163|   163|    background: var(--color-bg);
   164|   164|    padding: 1rem 1rem 0.75rem;
   165|   165|    border-bottom: 1px solid var(--color-border);
   166|   166|}
   167|   167|
   168|   168|.counter-sticky-inner {
   169|   169|    max-width: 600px;
   170|   170|    margin: 0 auto;
   171|   171|    text-align: center;
   172|   172|}
   173|   173|
   174|   174|.counter-year {
   175|   175|    font-family: var(--font-body);
   176|   176|    font-size: clamp(1.2rem, 4vw, 1.8rem);
   177|   177|    font-weight: 700;
   178|   178|    color: var(--color-accent);
   179|   179|    line-height: 1.1;
   180|   180|}
   181|   181|
   182|   182|.counter-value {
   183|   183|    font-family: var(--font-heading);
   184|   184|    font-size: clamp(2.8rem, 14vw, 5rem);
   185|   185|    font-weight: 400;
   186|   186|    color: var(--color-pop-green);
   187|   187|    line-height: 1;
   188|   188|    text-shadow: 0 0 40px rgba(45, 106, 79, 0.25);
   189|   189|    transition: color var(--transition-base), text-shadow var(--transition-base);
   190|   190|    margin: 0.25rem 0;
   191|   191|}
   192|   192|
   193|   193|.counter-value.warning {
   194|   194|    color: var(--color-yellow);
   195|   195|    text-shadow: 0 0 60px rgba(196, 154, 58, 0.3);
   196|   196|}
   197|   197|
   198|   198|.counter-value.declining {
   199|   199|    color: var(--color-danger);
   200|   200|    text-shadow: 0 0 60px rgba(196, 30, 58, 0.3);
   201|   201|}
   202|   202|
   203|   203|.counter-value.critical {
   204|   204|    color: var(--color-danger-dark);
   205|   205|    text-shadow: 0 0 60px rgba(139, 0, 0, 0.4);
   206|   206|}
   207|   207|
   208|   208|.counter-label {
   209|   209|    font-size: 0.85rem;
   210|   210|    color: var(--color-text-secondary);
   211|   211|    font-style: italic;
   212|   212|}
   213|   213|
   214|   214|.counter-status {
   215|   215|    font-family: var(--font-body);
   216|   216|    font-size: 0.75rem;
   217|   217|    color: var(--color-text-muted);
   218|   218|    margin-top: 0.25rem;
   219|   219|}
   220|   220|
   221|   221|/* ===================================
   222|   222|   Timeline
   223|   223|   =================================== */
   224|   224|.timeline-wrap {
   225|   225|    max-width: 600px;
   226|   226|    margin: 0 auto;
   227|   227|    padding: 0.75rem 1rem;
   228|   228|}
   229|   229|
   230|   230|.timeline-track {
   231|   231|    position: relative;
   232|   232|    height: 6px;
   233|   233|    background: var(--color-bg-secondary);
   234|   234|    border-radius: 999px;
   235|   235|    overflow: hidden;
   236|   236|}
   237|   237|
   238|   238|.timeline-fill {
   239|   239|    position: absolute;
   240|   240|    top: 0;
   241|   241|    left: 0;
   242|   242|    height: 100%;
   243|   243|    background: linear-gradient(90deg, var(--color-pop-green), var(--color-danger));
   244|   244|    border-radius: 999px;
   245|   245|    width: 0%;
   246|   246|    will-change: width;
   247|   247|}
   248|   248|
   249|   249|.timeline-dots {
   250|   250|    display: flex;
   251|   251|    justify-content: space-between;
   252|   252|    padding: 0 2px;
   253|   253|    margin-top: 4px;
   254|   254|}
   255|   255|
   256|   256|.timeline-dot {
   257|   257|    width: 10px;
   258|   258|    height: 10px;
   259|   259|    border-radius: 50%;
   260|   260|    background: var(--color-bg-secondary);
   261|   261|    border: 2px solid var(--color-text-muted);
   262|   262|    transition: all var(--transition-base);
   263|   263|    flex-shrink: 0;
   264|   264|}
   265|   265|
   266|   266|.timeline-dot.active {
   267|   267|    background: var(--color-danger);
   268|   268|    border-color: var(--color-danger);
   269|   269|    box-shadow: 0 0 6px rgba(196, 30, 58, 0.4);
   270|   270|}
   271|   271|
   272|   272|.timeline-labels {
   273|   273|    display: flex;
   274|   274|    justify-content: space-between;
   275|   275|    font-family: var(--font-body);
   276|   276|    font-size: 0.7rem;
   277|   277|    color: var(--color-text-muted);
   278|   278|    margin-top: 2px;
   279|   279|    padding: 0 2px;
   280|   280|}
   281|   281|
   282|   282|/* ===================================
   283|   283|   Scroll Prompt
   284|   284|   =================================== */
   285|   285|.scroll-prompt {
   286|   286|    text-align: center;
   287|   287|    padding: 0.5rem 1rem 1rem;
   288|   288|    font-family: var(--font-body);
   289|   289|    font-size: 0.8rem;
   290|   290|    color: var(--color-text-muted);
   291|   291|    animation: scroll-bounce 2s ease-in-out infinite;
   292|   292|}
   293|   293|
   294|   294|.scroll-prompt .arrow {
   295|   295|    display: block;
   296|   296|    font-size: 1.4rem;
   297|   297|    margin-bottom: 0.25rem;
   298|   298|}
   299|   299|
   300|   300|@keyframes scroll-bounce {
   301|   301|    0%, 100% { transform: translateY(0); opacity: 0.6; }
   302|   302|    50% { transform: translateY(6px); opacity: 1; }
   303|   303|}
   304|   304|
   305|   305|/* ===================================
   306|   306|   Cards Section — scroll snap
   307|   307|   =================================== */
   308|   308|.cards-section {
   309|   309|    scroll-snap-type: y mandatory;
   310|   310|    overflow-y: auto;
   311|   311|    height: calc(100vh - var(--counter-height) - 60px);
}

/* Desktop adjustments */
@media (min-width: 768px) {
    .cards-section {
        height: calc(100vh - var(--counter-height) - 80px);
    }
   312|   312|    scroll-behavior: auto;
   313|   313|    -webkit-overflow-scrolling: touch;
   314|   314|}
   315|   315|
   316|   316|.card {
   317|   317|    scroll-snap-align: start;
   318|   318|    scroll-snap-stop: always;
   319|   319|    min-height: calc(100vh - var(--counter-height) - 80px);
   320|   320|    display: flex;
   321|   321|    flex-direction: column;
   322|   322|    justify-content: center;
   323|   323|    padding: 2rem 1rem;
   324|   324|    opacity: 0.35;
   325|   325|    transform: scale(0.97);
   326|   326|    transition: opacity 0.4s ease, transform 0.4s ease, background 0.4s ease;
   327|   327|    background: transparent;
   328|   328|}
   329|   329|
   330|   330|.card.active {
   331|   331|    opacity: 1;
   332|   332|    transform: scale(1);
   333|   333|    background: var(--color-bg-card-active);
   334|   334|}
   335|   335|
   336|   336|.card-inner {
   337|   337|    max-width: 600px;
   338|   338|    margin: 0 auto;
   339|   339|    width: 100%;
   340|   340|}
   341|   341|
   342|   342|.card-year {
   343|   343|    font-family: var(--font-heading);
   344|   344|    font-size: clamp(2.5rem, 8vw, 4rem);
   345|   345|    font-weight: 400;
   346|   346|    color: var(--color-accent);
   347|   347|    line-height: 1;
   348|   348|    margin-bottom: 0.25rem;
   349|   349|}
   350|   350|
   351|   351|.card-title {
   352|   352|    font-family: var(--font-body);
   353|   353|    font-size: clamp(1.2rem, 4vw, 1.6rem);
   354|   354|    font-weight: 700;
   355|   355|    color: var(--color-text-primary);
   356|   356|    margin-bottom: 1rem;
   357|   357|    line-height: 1.2;
   358|   358|}
   359|   359|
   360|   360|.card-image {
   361|   361|    margin: 0 0 1rem;
   362|   362|    border-radius: var(--radius-lg);
   363|   363|    overflow: hidden;
   364|   364|}
   365|   365|
   366|   366|.card-image img {
   367|   367|    width: 100%;
   368|   368|    height: auto;
   369|   369|    display: block;
   370|   370|    border-radius: var(--radius-lg);
   371|   371|}
   372|   372|
   373|   373|.card-image figcaption {
   374|   374|    font-size: 0.78rem;
   375|   375|    color: var(--color-text-muted);
   376|   376|    margin-top: 0.4rem;
   377|   377|    font-style: italic;
   378|   378|}
   379|   379|
   380|   380|.card-text {
   381|   381|    font-family: var(--font-body);
   382|   382|    font-size: clamp(0.95rem, 2.5vw, 1.1rem);
   383|   383|    color: var(--color-text-secondary);
   384|   384|    line-height: 1.65;
   385|   385|}
   386|   386|
   387|   387|.card-text .flag {
   388|   388|    font-size: 1.1em;
   389|   389|}
   390|   390|
   391|   391|/* End card */
   392|   392|.card-end {
   393|   393|    text-align: center;
   394|   394|}
   395|   395|
   396|   396|.card-end .card-year {
   397|   397|    color: var(--color-danger-dark);
   398|   398|}
   399|   399|
   400|   400|/* ===================================
   401|   401|   Sources bar
   402|   402|   =================================== */
   403|   403|.sources-bar {
   404|   404|    position: fixed;
   405|   405|    bottom: 0;
   406|   406|    left: 0;
   407|   407|    right: 0;
   408|   408|    z-index: 60;
   409|   409|    background: var(--color-bg-secondary);
   410|   410|    border-top: 1px solid var(--color-border);
   411|   411|}
   412|   412|
   413|   413|.sources-toggle {
   414|   414|    width: 100%;
   415|   415|    display: flex;
   416|   416|    align-items: center;
   417|   417|    justify-content: center;
   418|   418|    gap: 0.5rem;
   419|   419|    padding: 10px;
   420|   420|    background: none;
   421|   421|    border: none;
   422|   422|    color: var(--color-text-muted);
   423|   423|    font-family: var(--font-body);
   424|   424|    font-size: 0.8rem;
   425|   425|    cursor: pointer;
   426|   426|    text-transform: uppercase;
   427|   427|    letter-spacing: 0.1em;
   428|   428|    font-weight: 600;
   429|   429|}
   430|   430|
   431|   431|.sources-toggle-icon {
   432|   432|    transition: transform var(--transition-fast);
   433|   433|    font-size: 0.7rem;
   434|   434|}
   435|   435|
   436|   436|.sources-toggle[aria-expanded="true"] .sources-toggle-icon {
   437|   437|    transform: rotate(180deg);
   438|   438|}
   439|   439|
   440|   440|.sources-panel {
   441|   441|    max-height: 50vh;
   442|   442|    overflow-y: auto;
   443|   443|    padding: 0 1rem 1rem;
   444|   444|}
   445|   445|
   446|   446|.sources-panel[hidden] {
   447|   447|    display: none;
   448|   448|}
   449|   449|
   450|   450|.sources-panel h3 {
   451|   451|    font-family: var(--font-body);
   452|   452|    font-size: 0.85rem;
   453|   453|    color: var(--color-accent);
   454|   454|    margin: 1rem 0 0.5rem;
   455|   455|    font-weight: 700;
   456|   456|}
   457|   457|
   458|   458|.sources-panel ul {
   459|   459|    list-style: none;
   460|   460|    padding: 0;
   461|   461|}
   462|   462|
   463|   463|.sources-panel li {
   464|   464|    font-size: 0.82rem;
   465|   465|    color: var(--color-text-secondary);
   466|   466|    margin-bottom: 0.5rem;
   467|   467|    line-height: 1.4;
   468|   468|}
   469|   469|
   470|   470|.sources-panel a {
   471|   471|    color: var(--color-accent);
   472|   472|    text-decoration: none;
   473|   473|}
   474|   474|
   475|   475|.sources-panel a:hover {
   476|   476|    text-decoration: underline;
   477|   477|}
   478|   478|
   479|   479|.sources-note {
   480|   480|    font-size: 0.78rem;
   481|   481|    color: var(--color-text-muted);
   482|   482|    font-style: italic;
   483|   483|    margin-top: 1rem;
   484|   484|    padding-top: 0.75rem;
   485|   485|    border-top: 1px solid var(--color-border);
   486|   486|}
   487|   487|
   488|   488|/* ===================================
   489|   489|   Footer
   490|   490|   =================================== */
   491|   491|.footer {
   492|   492|    text-align: center;
   493|   493|    padding: 1.5rem 1rem;
   494|   494|    font-size: 0.8rem;
   495|   495|    color: var(--color-text-muted);
   496|   496|    font-family: var(--font-body);
   497|   497|}
   498|   498|
   499|   499|.footer a {
   500|   500|    color: var(--color-accent);
   501|   501|    text-decoration: none;
   502|   502|}
   503|   503|
   504|   504|/* ===================================
   505|   505|   Responsive
   506|   506|   =================================== */
   507|   507|
   508|/* ===================================
   509|   Mobile Optimizations (screens narrower than 768px)
   510|   =================================== */
   511|@media (max-width: 767px) {
   512|    :root {
   513|        --counter-height: 160px;
   514|    }
   515|
   516|    .counter-sticky {
   517|        padding: 0.75rem 1rem 0.5rem;
   518|    }
   519|
   520|    .counter-year {
   521|        font-size: clamp(1.1rem, 5vw, 1.4rem);
   522|    }
   523|
   524|    .counter-value {
   525|        font-size: clamp(2.2rem, 12vw, 3.5rem);
   526|    }
   527|
   528|    .counter-label {
   529|        font-size: 0.75rem;
   530|    }
   531|
   532|    .counter-status {
   533|        font-size: 0.7rem;
   534|    }
   535|
   536|    .timeline-wrap {
   537|        padding: 0.5rem 1rem;
   538|    }
   539|
   540|    .timeline-labels {
   541|        font-size: 0.6rem;
   542|    }
   543|
   544|    .scroll-prompt {
   545|        padding: 0.4rem 1rem 0.8rem;
   546|        font-size: 0.75rem;
   547|    }
   548|
   549|    .card {
   550|        padding: 1.5rem 1rem;
   551|        min-height: calc(100vh - var(--counter-height) - 60px);
   552|    }
   553|
   554|    .card-year {
   555|        font-size: clamp(2rem, 7vw, 3rem);
   556|        margin-bottom: 0.2rem;
   557|    }
   558|
   559|    .card-title {
   560|        font-size: clamp(1rem, 3.5vw, 1.3rem);
   561|        margin-bottom: 0.75rem;
   562|        line-height: 1.25;
   563|    }
   564|
   565|    .card-image {
   566|        margin-bottom: 0.75rem;
   567|    }
   568|
   569|    .card-text {
   570|        font-size: clamp(1rem, 3vw, 1.1rem);
   571|        line-height: 1.6;
